From b2d448916be771cd228f709c23c474942008e3e8 Mon Sep 17 00:00:00 2001
From: Zhong Jianxin <azuwis@gmail.com>
Date: Wed, 9 Mar 2022 17:44:46 +0800
Subject: [PATCH] Fix run against librosa 0.9.0

librosa 0.9.0 switched to keyword-only arguments
---
 piano_transcription_inference/utilities.py | 2 +-
 setup.py                                   | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/piano_transcription_inference/utilities.py b/piano_transcription_inference/utilities.py
index 75efa37..e73e301 100644
--- a/piano_transcription_inference/utilities.py
+++ b/piano_transcription_inference/utilities.py
@@ -553,7 +553,7 @@ def load_audio(path, sr=22050, mono=True, offset=0.0, duration=None,
                 y = librosa.core.audio.to_mono(y)
 
         if sr is not None:
-            y = librosa.core.audio.resample(y, sr_native, sr, res_type=res_type)
+            y = librosa.core.audio.resample(y, orig_sr=sr_native, target_sr=sr, res_type=res_type)
 
         else:
             sr = sr_native
diff --git a/setup.py b/setup.py
index c9a938c..307922d 100644
--- a/setup.py
+++ b/setup.py
@@ -18,6 +18,6 @@
         "License :: OSI Approved :: MIT License",
         "Operating System :: OS Independent",
     ],
-    install_requires=['matplotlib', 'mido', 'librosa', 'torchlibrosa'],
+    install_requires=['matplotlib', 'mido', 'librosa>=0.9.0', 'torchlibrosa'],
     python_requires='>=3.6',
 )
